# SQLite for local dev (zero setup). For production, point this at a
# Postgres database instead (see README) and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run seed` to create the first admin user.
SEED_ADMIN_EMAIL="admin@arfad.com.sa"
SEED_ADMIN_PASSWORD="changeme123"
